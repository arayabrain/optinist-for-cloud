# Template for e2e/.env.prod, which E2E_TARGET=prod loads in place of e2e/.env.
# Copy it, fill in the credentials from the shared store, and leave the copy
# untracked. A target file stands for a whole environment: the run fails at
# start-up if BASE_URL, API_URL, HEALTH_ENV or the TEST_USER_* pair is missing.
BASE_URL=https://www.araya-optinist.com
API_URL=https://www.araya-optinist.com
HEALTH_ENV=subscr
RDS_PROXY_HOST=subscr-optinist-rds-proxy.proxy-cdmeogcuo1v2.ap-northeast-1.rds.amazonaws.com
RDS_SECRET_ID=subscr-optinist/database/config
RDS_SSM_INSTANCE_NAME=subscr-optinist-background
STRIPE_SECRET_ENV=subscr-optinist
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional. TEST_PREMIUM_* is a database state an admin stages with
# PUT /admin/users/{id}/subscription; TEST_STRIPE_* needs an account that owns a
# real Stripe subscription, and 18-stripe-audit skips on production without it.
TEST_PREMIUM_EMAIL=
TEST_PREMIUM_PASSWORD=
TEST_STRIPE_EMAIL=
TEST_STRIPE_PASSWORD=
