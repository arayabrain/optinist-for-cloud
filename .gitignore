.DS_Store
__pycache__
.ipynb_checkpoints
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
dist
/build

*.namespace.yaml.lock

files/*
Pipfile.lock
*.egg-info
.tox
.snakemake
.pytest_cache
.claude

# studio/test_data holds fixtures, but the suites also write generated trees
# into it -- OUTPUT_DIR, and whatever an absolute path in a stored config
# resolves to. Allow-list the fixtures so a new generated directory is ignored
# by default rather than committed by a stray `git add`.
studio/test_data/*
!studio/test_data/conda_envs/
!studio/test_data/input/
!studio/test_data/logs/
!studio/test_data/output_test/
!studio/test_data/test_workflow/
docs/_build

studio/notebooks
conda/envs/*
tensorflow-*.whl

.env*
!*.env*.example

# Terraform provisioner build artifacts (copied/installed by terraform apply)
infrastructure/terraform/*/aws_constants.py
infrastructure/terraform/aws_constants_layer/
infrastructure/terraform/*_package/pymysql/
infrastructure/terraform/*_package/pymysql-*.dist-info/

# Playwright artifacts
test-results/
